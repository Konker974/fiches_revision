# Copier en .env et adapter. Le fichier .env ne doit jamais être versionné.

# Chemin du JSON brut (par défaut : ../orders.json)
# RAW_DATA_PATH=../orders.json

# Base de données (par défaut : SQLite dans data/shop.db)
# DATABASE_URL=mysql+pymysql://shop_user:change_me@localhost:3307/shop
# DATABASE_URL=postgresql+psycopg://shop_user:change_me@localhost:5433/shop

# Variables lues par docker-compose.yml (MySQL)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=shop
MYSQL_USER=shop_user
MYSQL_PASSWORD=change_me

# Variables lues par docker-compose.postgres.yml (PostgreSQL + pgAdmin)
POSTGRES_DB=shop
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=change_me
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
